{
  "openapi": "3.0.0",
  "info": {
    "title": "Boruta Administration Frontend",
    "description": "Browser routes and static assets served by the Boruta administration frontend.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "variables": {}
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Frontend"
        ],
        "summary": "Serve the admin frontend",
        "responses": {
          "200": {
            "$ref": "#/components/responses/AdminFrontend"
          }
        },
        "security": []
      }
    },
    "/.well-known/acme-challenge/{token}": {
      "get": {
        "tags": [
          "Frontend"
        ],
        "summary": "Retrieve an ACME HTTP-01 challenge response",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "ACME challenge token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ACME challenge key authorization",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Challenge token not found"
          }
        },
        "security": []
      }
    },
    "/assets/{filename}": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Serve a compiled admin frontend asset",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "description": "Logical or Phoenix-digested asset filename, such as app.umd.js or app.umd-<digest>.js.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vsn",
            "in": "query",
            "required": false,
            "description": "Phoenix static asset version marker used by digested URLs.",
            "schema": {
              "type": "string",
              "example": "d"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AdminAsset"
          }
        },
        "security": []
      }
    },
