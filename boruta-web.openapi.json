{
  "openapi": "3.0.0",
  "info": {
    "title": "Boruta Authorization and Identity",
    "description": "OAuth 2.0, OpenID Connect, verifiable credential, DID status, and user identity endpoints exposed by BorutaWeb. BorutaIdentity routes are mounted below /accounts.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Default release endpoint"
    },
    {
      "url": "http://localhost:4000",
      "description": "Development endpoint"
    }
  ],
  "paths": {
    "/.well-known/oauth-authorization-server": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Get OAuth authorization server metadata",
        "responses": {
          "200": {"$ref": "#/components/responses/AuthorizationServerMetadata"}
        },
        "security": []
      }
    },
    "/.well-known/openid-configuration": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Get OpenID Provider metadata",
        "responses": {
          "200": {"$ref": "#/components/responses/AuthorizationServerMetadata"}
        },
        "security": []
      }
    },
    "/.well-known/openid-credential-issuer": {
      "get": {
        "tags": ["Discovery"],
        "summary": "Get OpenID credential issuer metadata",
        "responses": {
          "200": {"$ref": "#/components/responses/CredentialIssuerMetadata"}
        },
        "security": []
      }
    },
    "/.well-known/acme-challenge/{token}": {
      "get": {
        "tags": ["Infrastructure"],
        "summary": "Retrieve an ACME HTTP-01 challenge response",
        "parameters": [
          {"$ref": "#/components/parameters/AcmeToken"}
        ],
        "responses": {
          "200": {
            "description": "ACME challenge key authorization",
            "content": {
              "text/plain": {"schema": {"type": "string"}}
            }
          },
          "404": {"description": "Challenge token not found"}
        },
        "security": []
      }
    },
    "/favicon.ico": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve the Boruta favicon",
        "responses": {"200": {"$ref": "#/components/responses/IconAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/robots.txt": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve robots.txt",
        "responses": {"200": {"$ref": "#/components/responses/TextAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/css/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an authorization-server stylesheet",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/StylesheetAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/fonts/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an authorization-server font",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/FontAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/images/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an authorization-server image",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/ImageAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/js/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an authorization-server JavaScript asset",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/JavaScriptAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/admin/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an authorization-server admin asset",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/StaticAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve a top-level identity asset",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/StaticAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/css/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an identity stylesheet",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/StylesheetAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/js/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an identity JavaScript asset",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/JavaScriptAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/images/{filename}": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve an identity image",
        "parameters": [{"$ref": "#/components/parameters/AssetFilename"}],
        "responses": {"200": {"$ref": "#/components/responses/ImageAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/manifest.json": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve the identity web app manifest",
        "responses": {"200": {"$ref": "#/components/responses/ManifestAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/favicon.ico": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve the identity favicon",
        "responses": {"200": {"$ref": "#/components/responses/IconAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/robots.txt": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve the identity robots.txt",
        "responses": {"200": {"$ref": "#/components/responses/TextAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/accounts/semantic-ui.min.css": {
      "get": {
        "tags": ["Assets"],
        "summary": "Serve the identity Semantic UI stylesheet",
        "responses": {"200": {"$ref": "#/components/responses/StylesheetAsset"}, "404": {"description": "Asset not found"}},
        "security": []
      }
    },
    "/healthcheck": {
      "get": {
        "tags": ["Infrastructure"],
        "summary": "Check service health",
        "responses": {
          "204": {"description": "Service is healthy"}
        },
        "security": []
      }
    },
    "/oauth/authorize": {
      "get": {
        "tags": ["OAuth 2.0"],
        "summary": "Start an authorization request",
        "parameters": [
          {"name": "client_id", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "redirect_uri", "in": "query", "required": false, "schema": {"type": "string", "format": "uri"}},
          {"name": "response_type", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "scope", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "state", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "nonce", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "code_challenge", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "code_challenge_method", "in": "query", "required": false, "schema": {"type": "string", "enum": ["plain", "S256"]}},
          {"name": "prompt", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "max_age", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}},
          {"name": "request", "in": "query", "required": false, "description": "JWT-secured authorization request", "schema": {"type": "string"}},
          {"name": "request_uri", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/HtmlPage"},
          "302": {"$ref": "#/components/responses/Redirect"},
          "400": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": []
      }
    },
    "/oauth/token": {
      "post": {
        "tags": ["OAuth 2.0"],
        "summary": "Issue or refresh tokens",
        "requestBody": {"$ref": "#/components/requestBodies/TokenRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/TokenResponse"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"clientBasic": []}, {}]
      },
      "options": {
        "tags": ["CORS"],
        "summary": "CORS preflight",
        "responses": {"204": {"description": "Preflight accepted"}},
        "security": []
      }
    },
    "/oauth/introspect": {
      "post": {
        "tags": ["OAuth 2.0"],
        "summary": "Introspect a token",
        "requestBody": {"$ref": "#/components/requestBodies/IntrospectionRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/IntrospectionResponse"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"clientBasic": []}, {}]
      },
      "options": {
        "tags": ["CORS"],
        "summary": "CORS preflight",
        "responses": {"204": {"description": "Preflight accepted"}},
        "security": []
      }
    },
    "/oauth/pushed_authorization_request": {
      "post": {
        "tags": ["OAuth 2.0"],
        "summary": "Create a pushed authorization request",
        "requestBody": {"$ref": "#/components/requestBodies/PushedAuthorizationRequest"},
        "responses": {
          "201": {"$ref": "#/components/responses/PushedAuthorizationResponse"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"clientBasic": []}, {}]
      }
    },
    "/oauth/revoke": {
      "post": {
        "tags": ["OAuth 2.0"],
        "summary": "Revoke a token",
        "requestBody": {"$ref": "#/components/requestBodies/RevocationRequest"},
        "responses": {
          "200": {"description": "Token revoked or already invalid"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"clientBasic": []}, {}]
      },
      "options": {
        "tags": ["CORS"],
        "summary": "CORS preflight",
        "responses": {"204": {"description": "Preflight accepted"}},
        "security": []
      }
    },
    "/oauth/userinfo": {
      "get": {
        "tags": ["OpenID Connect"],
        "summary": "Get claims for the authenticated subject",
        "responses": {
          "200": {"$ref": "#/components/responses/UserInfoResponse"},
          "401": {"description": "Missing or invalid access token"}
        },
        "security": [{"bearer": []}]
      },
      "post": {
        "tags": ["OpenID Connect"],
        "summary": "Get claims for the authenticated subject",
        "responses": {
          "200": {"$ref": "#/components/responses/UserInfoResponse"},
          "401": {"description": "Missing or invalid access token"}
        },
        "security": [{"bearer": []}]
      }
    },
    "/openid/credential": {
      "post": {
        "tags": ["OpenID for Verifiable Credentials"],
        "summary": "Issue a credential",
        "requestBody": {"$ref": "#/components/requestBodies/CredentialRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/CredentialResponse"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"bearer": []}]
      },
      "options": {
        "tags": ["CORS"],
        "summary": "CORS preflight",
        "responses": {"204": {"description": "Preflight accepted"}},
        "security": []
      }
    },
    "/openid/defered-credential": {
      "post": {
        "tags": ["OpenID for Verifiable Credentials"],
        "summary": "Retrieve a deferred credential",
        "description": "The route uses the spelling implemented by the service: defered-credential.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"acceptance_token": {"type": "string"}},
                "required": ["acceptance_token"]
              }
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/CredentialResponse"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "401": {"$ref": "#/components/responses/OAuthError"}
        },
        "security": [{"bearer": []}]
      }
    },
    "/openid/jwks": {
      "get": {
        "tags": ["OpenID Connect"],
        "summary": "List JSON Web Keys",
        "responses": {
          "200": {"$ref": "#/components/responses/JwksResponse"}
        },
        "security": []
      }
    },
    "/openid/jwks/{client_id}": {
      "get": {
        "tags": ["OpenID Connect"],
        "summary": "Get JSON Web Keys for a client",
        "parameters": [{"$ref": "#/components/parameters/ClientId"}],
        "responses": {
          "200": {"$ref": "#/components/responses/JwksResponse"},
          "404": {"description": "Client not found"}
        },
        "security": []
      }
    },
    "/openid/direct_post/{code_id}": {
      "post": {
        "tags": ["OpenID for Verifiable Presentations"],
        "summary": "Submit a direct-post authorization response",
        "parameters": [{"$ref": "#/components/parameters/CodeId"}],
        "requestBody": {"$ref": "#/components/requestBodies/DirectPostRequest"},
        "responses": {
          "302": {"$ref": "#/components/responses/Redirect"},
          "400": {"$ref": "#/components/responses/OAuthError"},
          "404": {"description": "Authorization code not found"}
        },
        "security": []
      }
    },
    "/openid/presentation_sse": {
      "get": {
        "tags": ["OpenID for Verifiable Presentations"],
        "summary": "Stream presentation authentication status",
        "parameters": [
          {"name": "code", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Server-sent authentication events",
            "content": {"text/event-stream": {"schema": {"type": "string"}}}
          }
        },
        "security": []
      },
      "options": {
        "tags": ["CORS"],
        "summary": "CORS preflight",
        "responses": {"204": {"description": "Preflight accepted"}},
        "security": []
      }
    },
    "/did/resolve_status/{status}": {
      "get": {
        "tags": ["DID and Verifiable Credentials"],
        "summary": "Resolve a verifiable credential status",
        "parameters": [
          {"name": "status", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Resolved status",
            "content": {"text/plain": {"schema": {"type": "string"}}}
          }
        },
        "security": []
      }
    },
